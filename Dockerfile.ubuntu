# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=ubuntu:26.04

FROM ${BASE_IMAGE} AS source
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends gpgv \
 && rm -rf /var/lib/apt/lists/*
ARG VERSION
ARG SOURCE_SHA256
ADD --checksum=sha256:${SOURCE_SHA256} https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${VERSION}.tar.gz /src/
ADD https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${VERSION}.tar.gz.asc /src/
# OpenSSH release signing key (Damien Miller), fingerprint
# 7168 B983 815A 5EEF 59A4 ADFD 2A3F 414E 7360 60BA. A release signed with
# another key fails here until that key is added.
COPY keys/openssh-release.gpg /tmp/openssh-release.gpg
WORKDIR /src
RUN set -eu; \
    gpgv --keyring /tmp/openssh-release.gpg "openssh-${VERSION}.tar.gz.asc" "openssh-${VERSION}.tar.gz"; \
    mkdir openssh; \
    tar -xzf "openssh-${VERSION}.tar.gz" -C openssh --strip-components=1

FROM ${BASE_IMAGE} AS build
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]
# The base image's packages are recorded before anything is installed, so that
# runtime-deps can leave them out. Every image that installs runtime-deps is
# built on the same base.
RUN dpkg-query -W -f '${Package}\n' | sort -u > /tmp/base-packages \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      libedit-dev \
      libssl-dev \
      pkgconf \
      zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*
COPY --link --from=source /src/openssh /src/openssh
WORKDIR /src/openssh
ARG JOBS
# Only the client programs and the helpers they start are built: no sshd,
# sshd-session, sshd-auth or ssh-keysign. configure leaves out what it cannot
# find without failing, so config.h is checked. The programs go to
# libexec/openssh/bin; /usr/local/bin has links to wrapper.sh, which starts
# them under any UID.
RUN --mount=type=bind,source=wrapper.sh,target=/tmp/wrapper.sh \
    set -eu; \
    ./configure \
      --prefix=/usr/local \
      --sysconfdir=/etc/ssh \
      --libexecdir=/usr/local/libexec/openssh \
      --with-libedit \
      --without-security-key-builtin \
      --disable-utmp \
      --disable-wtmp \
      --disable-lastlog; \
    for define in WITH_OPENSSL WITH_ZLIB USE_LIBEDIT ENABLE_PKCS11 ENABLE_SK; do \
      grep -Eq "^#define ${define}( |\$)" config.h || { echo "configure turned off ${define}" >&2; exit 1; }; \
    done; \
    if grep -Eq '^#define (ENABLE_SK_INTERNAL|USE_PAM|GSSAPI|KRB5)( |$)' config.h; then \
      echo "configure turned on built-in FIDO, PAM or Kerberos support" >&2; \
      exit 1; \
    fi; \
    make -j"${JOBS:-$(nproc)}" \
      ssh scp sftp ssh-add ssh-agent ssh-keygen ssh-keyscan \
      sftp-server ssh-pkcs11-helper ssh-sk-helper; \
    libexec=/out/usr/local/libexec/openssh; \
    install -d /out/usr/local/bin "$libexec/bin"; \
    install -m 755 ssh scp sftp ssh-add ssh-agent ssh-keygen ssh-keyscan "$libexec/bin/"; \
    install -m 755 sftp-server ssh-pkcs11-helper ssh-sk-helper "$libexec/"; \
    strip --strip-unneeded "$libexec"/bin/* "$libexec/sftp-server" "$libexec/ssh-pkcs11-helper" "$libexec/ssh-sk-helper"; \
    install -m 755 /tmp/wrapper.sh "$libexec/wrapper"; \
    for tool in ssh scp sftp ssh-add ssh-agent ssh-keygen ssh-keyscan; do \
      ln -s ../libexec/openssh/wrapper "/out/usr/local/bin/${tool}"; \
    done

ARG BASE_IMAGE
ARG VERSION
# runtime-deps lists the packages that own the libraries the binaries load,
# minus the base image's packages, plus the packages in runtime-deps.ubuntu.
# The ML-KEM and ML-DSA code compiled into every program is Cryspen's libcrux,
# under the MIT license, which LICENCE does not cover; its notice and copyright
# lines are copied as well. wrapper.sh comes from this repository, so the
# repository's LICENSE goes with it.
RUN --mount=type=bind,source=runtime-deps.ubuntu,target=/tmp/runtime-deps.extra \
    --mount=type=bind,source=LICENSE,target=/tmp/LICENSE.wrapper \
    set -eu; \
    printf '%s\n' "${VERSION}" | grep -Eqx '[0-9]+\.[0-9]+p[0-9]+' \
      || { echo "unexpected VERSION: ${VERSION}" >&2; exit 1; }; \
    meta=/out/usr/local/share/randomcontainers/openssh-client; \
    mkdir -p "$meta/licenses"; \
    cp LICENCE "$meta/licenses/"; \
    cp /tmp/LICENSE.wrapper "$meta/licenses/LICENSE.wrapper"; \
    { \
      sed -n '/^ \* MIT License$/,/^ \*\/$/p' libcrux_internal.h; \
      echo; \
      grep 'SPDX-FileCopyrightText' libcrux_internal.h | sort -u; \
    } > "$meta/licenses/LICENSE.libcrux"; \
    grep -q 'Copyright (c) .* Cryspen' "$meta/licenses/LICENSE.libcrux"; \
    grep -q 'SPDX-FileCopyrightText: .* Cryspen Sarl' "$meta/licenses/LICENSE.libcrux"; \
    grep -q 'Permission is hereby granted' "$meta/licenses/LICENSE.libcrux"; \
    echo "${VERSION}" > "$meta/version"; \
    printf '%s\n' \
      "https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${VERSION}.tar.gz" \
      "https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${VERSION}.tar.gz.asc" \
      "https://github.com/randomcontainers/openssh-client/releases/tag/v${VERSION}" \
      > "$meta/source"; \
    /out/usr/local/libexec/openssh/bin/ssh -V 2> /tmp/ssh-version; \
    if ! head -n 1 /tmp/ssh-version | grep -Fq "OpenSSH_${VERSION}, OpenSSL "; then \
      cat /tmp/ssh-version >&2; \
      exit 1; \
    fi; \
    { \
      echo "base: ${BASE_IMAGE}"; \
      echo "compiler: $(cc --version | head -n 1)"; \
      sed -n 's/^  \$ \(\.\/configure.*\)/\1/p' config.log; \
      cat /tmp/ssh-version; \
    } > "$meta/buildinfo"; \
    find /out/usr/local -type f \( -perm -u+x -o -name '*.so*' \) -print0 \
      | xargs -0 env LD_LIBRARY_PATH=/out/usr/local/lib ldd > /tmp/ldd 2>&1 || true; \
    if grep 'not found' /tmp/ldd; then exit 1; fi; \
    awk '$2 == "=>" && $3 ~ /^\// && $3 !~ /^\/out\// { print $3 }' /tmp/ldd | sort -u > /tmp/libs; \
    test -s /tmp/libs; \
    while read -r lib; do \
      real="$(readlink -f "$lib")"; \
      dpkg-query --search "*${real#/usr}"; \
    done < /tmp/libs | cut -d: -f1 | sort -u | comm -23 - /tmp/base-packages > /tmp/elf-deps; \
    sort -u /tmp/elf-deps /tmp/runtime-deps.extra > "$meta/runtime-deps"

FROM ${BASE_IMAGE} AS slim
ARG DEBIAN_FRONTEND=noninteractive
COPY --link --from=build /out/usr/local/ /usr/local/
RUN set -eu; \
    apt-get update; \
    xargs apt-get install -y --no-install-recommends ca-certificates tini < /usr/local/share/randomcontainers/openssh-client/runtime-deps; \
    rm -rf /var/lib/apt/lists/*; \
    install -d -m 1777 /work /cache
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "ssh"]
CMD ["-V"]
